# Скопируй этот файл в .env и заполни значения. Файл .env в git НЕ попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID владельцев через запятую (числа, не @юзернеймы).
# Узнать свой ID можно у бота @userinfobot. Тут нужны ID обеих владелиц.
OWNER_IDS=111111111,222222222

# (необязательно) @юзернеймы владельцев через запятую, без @ — показываются в "Платных услугах"
OWNER_USERNAMES=

# (необязательно) канал, на который нужна подписка. По умолчанию @s1ren_33.
# Бот должен быть АДМИНИСТРАТОРОМ этого канала, иначе проверить подписку он не сможет.
# Оставь пустым (REQUIRED_CHANNEL=), чтобы выключить проверку подписки.
REQUIRED_CHANNEL=@s1ren_33
# (нужно только для закрытого канала, где указан числовой ID) ссылка-приглашение для кнопки «Подписаться»
CHANNEL_URL=

# (необязательно) путь к файлу базы SQLite
DB_PATH=data/bot.db
